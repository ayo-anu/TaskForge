# Local development only. Copy to .env and replace every password value.
POSTGRES_DB=taskforge
POSTGRES_OWNER_USER=taskforge_owner
POSTGRES_OWNER_PASSWORD=replace-with-local-owner-password
POSTGRES_USER=taskforge_runtime
POSTGRES_PASSWORD=replace-with-local-runtime-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=taskforge
RABBITMQ_DEFAULT_PASS=replace-with-local-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=taskforge
RABBITMQ_HOST=127.0.0.1
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PASSWORD=replace-with-local-redis-password
REDIS_PORT=6379

TASKFORGE_API_HOST=127.0.0.1
TASKFORGE_API_PORT=8000
TASKFORGE_READINESS_TIMEOUT_SECONDS=2.0
TASKFORGE_AUTHENTICATION_TIMEOUT_SECONDS=2.0
TASKFORGE_RATE_LIMIT_TIMEOUT_SECONDS=0.25
TASKFORGE_RATE_LIMIT_FALLBACK_CAPACITY=10000
TASKFORGE_RATE_LIMIT_CLEANUP_RETENTION_SECONDS=3600
TASKFORGE_API_AUTH_NETWORK_FAILURES_PER_MINUTE=30
TASKFORGE_API_AUTH_CREDENTIAL_FAILURES_PER_FIVE_MINUTES=10
TASKFORGE_WORKER_AUTH_NETWORK_FAILURES_PER_MINUTE=30
TASKFORGE_WORKER_AUTH_CREDENTIAL_FAILURES_PER_FIVE_MINUTES=10
TASKFORGE_RUN_CREATIONS_PER_MINUTE=60
TASKFORGE_RUN_REPLAYS_PER_MINUTE=12
TASKFORGE_DEAD_LETTER_REDRIVES_PER_MINUTE=6
TASKFORGE_WORKER_REGISTRATIONS_PER_MINUTE=10
TASKFORGE_WORKER_RESULTS_PER_MINUTE=1200
TASKFORGE_WEBSOCKET_CONNECTIONS_PER_NETWORK_MINUTE=120
TASKFORGE_WEBSOCKET_CONNECTIONS_PER_PRINCIPAL_MINUTE=30
TASKFORGE_EXECUTION_STREAM_MAX_CONNECTIONS_PER_PRINCIPAL=5
TASKFORGE_DATABASE_POOL_SIZE=5
TASKFORGE_DATABASE_POOL_TIMEOUT_SECONDS=2.0
# Alembic uses TASKFORGE_DATABASE_URL with owner credentials supplied by the shell.
# The administrative identity-provisioning CLI uses POSTGRES_OWNER_* above.
# Existing database volumes: run `make privilege-bootstrap` before Alembic 0027.
