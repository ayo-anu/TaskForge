# Reference names only; this file is intentionally not deployable. Copy it to
# the ignored .env file, generate strong values for the four initially required
# secrets below, and restrict that file to the operator account.
POSTGRES_DB=taskforge
POSTGRES_OWNER_USER=taskforge_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_USER=taskforge_runtime
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=taskforge
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=taskforge
RABBITMQ_HOST=127.0.0.1
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Generate this independently of database and broker passwords. Every application
# role must receive the same value.
TASKFORGE_TASK_CLAIM_RESULT_AUTHORITY_SECRET=

# Leave this blank while PostgreSQL/RabbitMQ start and owner migrations run.
# After externally provisioning the worker identity, store the issued credential
# here before starting the worker. It is supplied only to the worker container.
TASKFORGE_WORKER_CREDENTIAL=
TASKFORGE_WORKER_PROFILE=pipeline

# Compose binds Uvicorn to 0.0.0.0 inside the container but publishes it only on
# host loopback. Externally reachable traffic requires a separately reviewed
# HTTPS/WSS edge and protected edge-to-Taskforge hop. Taskforge does not trust
# Forwarded or X-Forwarded-* headers.
TASKFORGE_API_PUBLISHED_PORT=8000
TASKFORGE_API_MAX_REQUEST_BODY_BYTES=10485760
TASKFORGE_READINESS_TIMEOUT_SECONDS=2.0
TASKFORGE_AUTHENTICATION_TIMEOUT_SECONDS=2.0
TASKFORGE_RATE_LIMIT_TIMEOUT_SECONDS=0.25
TASKFORGE_RATE_LIMIT_FALLBACK_CAPACITY=10000
TASKFORGE_RATE_LIMIT_CLEANUP_RETENTION_SECONDS=3600
TASKFORGE_API_AUTH_NETWORK_FAILURES_PER_MINUTE=30
TASKFORGE_API_AUTH_CREDENTIAL_FAILURES_PER_FIVE_MINUTES=10
TASKFORGE_WORKER_AUTH_NETWORK_FAILURES_PER_MINUTE=30
TASKFORGE_WORKER_AUTH_CREDENTIAL_FAILURES_PER_FIVE_MINUTES=10
TASKFORGE_RUN_CREATIONS_PER_MINUTE=60
TASKFORGE_RUN_REPLAYS_PER_MINUTE=12
TASKFORGE_DEAD_LETTER_REDRIVES_PER_MINUTE=6
TASKFORGE_WORKER_REGISTRATIONS_PER_MINUTE=10
TASKFORGE_WORKER_RESULTS_PER_MINUTE=1200
TASKFORGE_WEBSOCKET_CONNECTIONS_PER_NETWORK_MINUTE=120
TASKFORGE_WEBSOCKET_CONNECTIONS_PER_PRINCIPAL_MINUTE=30
TASKFORGE_EXECUTION_STREAM_MAX_CONNECTIONS_PER_PRINCIPAL=5
# JSON-encoded list of canonical trusted browser origins. An empty list denies
# browser Origin headers while native clients that omit Origin remain supported.
TASKFORGE_EXECUTION_STREAM_ALLOWED_ORIGINS=[]
TASKFORGE_EXECUTION_STREAM_MAX_SESSION_SECONDS=900
TASKFORGE_DATABASE_POOL_SIZE=5
TASKFORGE_DATABASE_POOL_TIMEOUT_SECONDS=2.0
# Alembic uses TASKFORGE_DATABASE_URL with owner credentials supplied by the shell.
# The administrative identity-provisioning CLI uses POSTGRES_OWNER_* above.
# Existing database volumes: run `make privilege-bootstrap` before Alembic 0027.
# Select compose.local-admin.yaml explicitly for loopback-only PostgreSQL and
# RabbitMQ access; it is never loaded automatically by Docker Compose.
#
# No universal CPU or memory limits are claimed. Size PostgreSQL from its working
# set and the aggregate application pool/listener connection budget; size RabbitMQ
# from durable queue depth and alarms. Tune worker replicas, profile mix, and
# prefetch independently in a private override after measuring representative load.
